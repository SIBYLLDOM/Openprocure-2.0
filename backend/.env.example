# Amazon SES (ap-south-1) — outbound email for the whole backend. Copy this
# file to .env and fill in the two blank values below; never commit the real
# .env (see backend/.gitignore).
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@openprocure.ai
